{
  "name": "@konceptware/eslint-config",
  "version": "0.6.1",
  "description": "Konceptware's shared ESLint flat configs: prod, test, vitest, jest, playwright, react, storybook; plus a stylelint config.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/konceptware/eslint-config.git"
  },
  "homepage": "https://github.com/konceptware/eslint-config#readme",
  "bugs": {
    "url": "https://github.com/konceptware/eslint-config/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./test": {
      "types": "./dist/test.d.mts",
      "import": "./dist/test.mjs",
      "default": "./dist/test.mjs"
    },
    "./vitest": {
      "types": "./dist/vitest.d.mts",
      "import": "./dist/vitest.mjs",
      "default": "./dist/vitest.mjs"
    },
    "./jest": {
      "types": "./dist/jest.d.mts",
      "import": "./dist/jest.mjs",
      "default": "./dist/jest.mjs"
    },
    "./playwright": {
      "types": "./dist/playwright.d.mts",
      "import": "./dist/playwright.mjs",
      "default": "./dist/playwright.mjs"
    },
    "./react": {
      "types": "./dist/react.d.mts",
      "import": "./dist/react.mjs",
      "default": "./dist/react.mjs"
    },
    "./storybook": {
      "types": "./dist/storybook.d.mts",
      "import": "./dist/storybook.mjs",
      "default": "./dist/storybook.mjs"
    },
    "./stylelint": {
      "types": "./dist/stylelint.d.mts",
      "import": "./dist/stylelint.mjs",
      "default": "./dist/stylelint.mjs"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@12.4.2",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "docs:rules": "jiti scripts/gen-rule-docs.ts",
    "inspect": "eslint-config-inspector",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "prepublishOnly": "pnpm typecheck && pnpm build && pnpm test"
  },
  "peerDependencies": {
    "@eslint-react/eslint-plugin": "^5.28.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.0.0",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-playwright": "^2.12.0",
    "eslint-plugin-react-hooks": "^7.1.0",
    "eslint-plugin-storybook": "^10.6.0",
    "stylelint": "^18.0.0",
    "typescript": ">=5.0.0 <6.1.0"
  },
  "peerDependenciesMeta": {
    "@vitest/eslint-plugin": {
      "optional": true
    },
    "eslint-plugin-jest": {
      "optional": true
    },
    "eslint-plugin-playwright": {
      "optional": true
    },
    "@eslint-react/eslint-plugin": {
      "optional": true
    },
    "eslint-plugin-react-hooks": {
      "optional": true
    },
    "eslint-plugin-jsx-a11y-x": {
      "optional": true
    },
    "eslint-plugin-storybook": {
      "optional": true
    },
    "stylelint": {
      "optional": true
    }
  },
  "dependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.13.0",
    "stylelint-config-standard": "^41.0.0",
    "typescript-eslint": "^8.72.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint-react/eslint-plugin": "^5.28.0",
    "@eslint/config-inspector": "^3.5.0",
    "@jest/globals": "^30.5.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-playwright": "^2.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.5",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "stylelint": "^18.0.0",
    "tsdown": "^0.23.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
