{
  "name": "@real-acrm/eslint-config",
  "version": "0.1.0",
  "private": true,
  "description": "Shared ESLint baseline for every real-acrm package. Consumers call baseline() and append only their override ledger.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@eslint/config-helpers": "^0.7.0",
    "@eslint/js": "^10.0.1",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.4.0",
    "globals": "^16.5.0",
    "typescript-eslint": "^8.69.0"
  },
  "peerDependencies": {
    "eslint": "^10.0.0"
  },
  "devDependencies": {
    "eslint": "^10.10.0",
    "prettier": "3.9.6",
    "typescript": "^5.9.3"
  }
}
